{
  "name": "kujira-seaside-study",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "engines": { "node": ">=22.18.0" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "assets:generate": "node scripts/generate-art.mjs",
    "assets:check": "node scripts/generate-art.mjs --check",
    "check": "npm run typecheck && npm test && npm run assets:check",
    "build": "npm run check && vite build",
    "build:public": "npm run check && vite build --mode public",
    "mac:prepare": "node scripts/prepare-macos.mjs",
    "mac:test": "node scripts/test-macos.mjs",
    "mac:build": "node scripts/build-macos.mjs",
    "mac:dmg": "node scripts/build-dmg.mjs",
    "mac:release": "node scripts/release-macos.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "7.3.8"
  }
}
